{
  "name": "santi020k-way-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Shared standards, agent integrations, and documentation for the santi020k way.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "audit:pull-requests": "node scripts/audit-pr-title-workflows.mjs",
    "audit:presentation": "node scripts/audit-repository-presentation.mjs",
    "audit:quality": "node scripts/audit-quality-gates.mjs",
    "audit:releases": "node scripts/audit-release-workflows.mjs",
    "commit": "commitprompt",
    "hooks:install": "quality hooks install",
    "audit:all": "node scripts/audit-release-workflows.mjs --check && node scripts/audit-repository-presentation.mjs --check && node scripts/audit-quality-gates.mjs && node scripts/audit-pr-title-workflows.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:artifacts",
    "lint": "pnpm --filter @santi020k/way build && eslint . --max-warnings=0",
    "lint:fix": "pnpm --filter @santi020k/way build && eslint . --fix --max-warnings=0",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json --noEmit",
    "test": "turbo run test",
    "test:browser": "playwright test",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "format": "pnpm --filter @santi020k/way build && eslint . --fix --max-warnings=0 && prettier --write \"**/*.{md,json,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{md,json,yml,yaml,css}\"",
    "changeset": "changeset",
    "way": "node packages/way/dist/cli.js",
    "package:release": "node scripts/package-release.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.34.3",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.64.0",
    "@santi020k/commitprompt": "^1.0.0",
    "@santi020k/eslint-config-astro": "3.0.0",
    "@santi020k/eslint-config-basic": "3.0.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "wrangler": "4.149.0"
  },
  "author": {
    "name": "Santiago Molina",
    "url": "https://santi020k.com"
  },
  "homepage": "https://way.santi020k.com"
}
