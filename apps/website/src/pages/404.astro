---
import { ButtonLink } from '@santi020k/lumen-astro'

import Base from '../layouts/Base.astro'
---

<Base
  title="Page not found"
  description="Find your way back to the shared standards."
>
  <section class="page-intro">
    <p class="eyebrow">404 / A different path</p>
    <h1>
      Let’s find
      <br />
      your way back.
    </h1>
    <p class="lead">This page isn’t in the catalog.</p>
    <ButtonLink href="/standards/">Browse the standards</ButtonLink>
  </section>
</Base>
