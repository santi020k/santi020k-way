---
import { Icon } from '@santi020k/lumen-astro'
import { readCatalog } from '@santi020k/way/catalog'

import { navigation } from '../lib/navigation'

import Wordmark from './Wordmark.astro'
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-main">
      <div class="footer-identity">
        <Wordmark />
        <p class="footer-statement">Good work.<br /><span>Shared foundations.</span></p>
        <p class="footer-description">Design language, engineering habits, and the decisions worth carrying forward.</p>
      </div>
      <nav class="footer-links" aria-labelledby="footer-explore">
        <h2 id="footer-explore">Explore Way</h2>
        {navigation.map(link => <a href={link.href}>{link.label}</a>)}
      </nav>
      <nav class="footer-links" aria-labelledby="footer-foundations">
        <h2 id="footer-foundations">The foundations</h2>
        <a href="/standards/design/">Design & brand</a>
        <a href="/standards/packages/">Libraries & tools</a>
        <a href="https://lumen.santi020k.com" target="_blank" rel="noopener noreferrer">Lumen UI<Icon name="arrow-up-right" aria-hidden="true" /></a>
        <a href="https://theme.santi020k.com" target="_blank" rel="noopener noreferrer">Santi020k Theme<Icon name="arrow-up-right" aria-hidden="true" /></a>
      </nav>
    </div>
    <div class="footer-bottom">
      <p class="footer-version"><span>v{readCatalog().version}</span> Open source · MIT</p>
      <a class="footer-credit" href="https://santi020k.com" target="_blank" rel="noopener noreferrer">Made by <span>Santiago Molina</span><Icon name="arrow-up-right" aria-hidden="true" /></a>
      <a class="back-to-top" href="#top">Back to top<Icon name="arrow-up" aria-hidden="true" /></a>
    </div>
  </div>
</footer>
