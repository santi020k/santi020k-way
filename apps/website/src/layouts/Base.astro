---
import '@santi020k/lumen-astro/styles.css'
import '@santi020k/theme/site.css'
import '@santi020k/theme/typography.css'
import '../styles/site.css'

import { Icon, ThemeToggle } from '@santi020k/lumen-astro'
import UIPrimitives from '@santi020k/lumen-astro/runtime'
import { readCatalog } from '@santi020k/way/catalog'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const active = Astro.url.pathname
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · The santi020k Way</title>
    <meta name="description" content={description} />
    <meta name="author" content="Santiago Molina" />
    <meta name="theme-color" content="#110c1d" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · The santi020k Way`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label="The santi020k Way home">
        <span class="brand-mark" aria-hidden="true">
          &gt;_
        </span>
        <span>
          santi020k<span class="wordmark-way"> / way</span>
        </span>
      </a>
      <nav aria-label="Main navigation">
        <a
          href="/standards/"
          aria-current={active.startsWith('/standards') ? 'page' : undefined}
        >
          Standards
        </a>
        <a
          href="/architecture/"
          aria-current={active === '/architecture/' ? 'page' : undefined}
        >
          Architecture
        </a>
        <a
          href="/start/"
          aria-current={active === '/start/' ? 'page' : undefined}
        >
          Get started <Icon name="arrow-up-right" aria-hidden="true" />
        </a>
      </nav>
      <ThemeToggle storageKey="way-theme" aria-label="Toggle color theme" />
    </header>
    <main id="main" class="shell" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer shell">
      <div>
        <a class="footer-brand" href="/">
          The santi020k Way
        </a>
        <p>Clear decisions. Considered design. Dependable delivery.</p>
      </div>
      <div class="footer-links">
        <a href="/standards/">Read the standards</a>
        <a
          href="https://santi020k.com"
          target="_blank"
          rel="noopener noreferrer"
        >
          Made by Santiago Molina{' '}
          <Icon name="arrow-up-right" aria-hidden="true" />
        </a>
      </div>
      <p class="footer-note">Open conventions · Local-first tools · v{readCatalog().version}</p>
    </footer>
    <UIPrimitives />
  </body>
</html>
